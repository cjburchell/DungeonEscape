@inject DataSourceCatalog DataSources
@inject DataFolderService Data

<div class="complex-list">
    @if (Items.Count == 0)
    {
        <div class="tag-empty">No choices</div>
    }
    else
    {
        @for (var i = 0; i < Items.Count; i++)
        {
            var index = i;
            <div class="card-row nested-card">
                <div class="field">
                    <label>Choice Text</label>
                    <input value="@Items[index].Text" @onchange="e => UpdateAt(index, choice => choice.Text = e.Value?.ToString() ?? string.Empty)" />
                </div>

                <div class="field-grid">
                    <TextReferenceSelect Label="Quest" Value="@Items[index].Quest" ValueChanged="value => UpdateQuest(index, value)"
                                         Options="DataSources.Quests" IncludeNone="true" />
                    <ItemReferenceSelect Label="Item" Value="@Items[index].ItemId"
                                         ValueChanged="value => UpdateAt(index, choice => choice.ItemId = value)"
                                         IncludeNone="true" />
                    <MonsterReferenceSelect Label="Monster" Value="@Items[index].Monster"
                                            ValueChanged="value => UpdateAt(index, choice => choice.Monster = value)"
                                            IncludeNone="true" />
                    @if (!string.IsNullOrWhiteSpace(GetEffectiveQuestId(index)))
                    {
                        <div class="field">
                            <label>Next Quest Stage</label>
                            <select value="@NextQuestStageValue(index)" @onchange="e => UpdateNextQuestStage(index, e.Value?.ToString())">
                                <option value="">-- none --</option>
                                @foreach (var stage in GetQuestStageNumbers(GetEffectiveQuestId(index)))
                                {
                                    <option value="@stage">@stage</option>
                                }
                            </select>
                        </div>
                    }
                    <TextReferenceSelect Label="Map Id" Value="@Items[index].MapId" ValueChanged="value => UpdateMap(index, value)"
                                         Options="MapOptions" IncludeNone="true" />
                    <TextReferenceSelect Label="Spawn Id" Value="@Items[index].SpawnId"
                                         ValueChanged="value => UpdateAt(index, choice => choice.SpawnId = value)"
                                         Options="@GetSpawnOptions(Items[index].MapId)" IncludeNone="true" />
                    <NumberField Label="Object Id" Value="@(Items[index].ObjectId ?? 0)"
                                 ValueChanged="value => UpdateAt(index, choice => choice.ObjectId = value)" />
                </div>

                <fieldset>
                    <legend>Actions</legend>
                    <EnumMultiSelect TEnum="QuestAction" Selected="EnsureActions(index)" SelectedChanged="actions => OnActionsChanged(index, actions)" OnChanged="OnChanged" />
                </fieldset>

                <fieldset>
                    <legend>Items</legend>
                    <StringListEditor Items="EnsureItems(index)" Options="DataSources.Items" OnChanged="OnChanged" />
                </fieldset>

                <fieldset>
                    <legend>Nested Dialog</legend>
                    @if (Items[index].Dialog == null)
                    {
                        <button @onclick="() => AddNestedDialog(index)">Add Response</button>
                    }
                    else
                    {
                        <div class="field">
                            <label>Text</label>
                            <textarea rows="3" value="@Items[index].Dialog.Text"
                                      @onchange="e => UpdateAt(index, choice => choice.Dialog.Text = e.Value?.ToString() ?? string.Empty)"></textarea>
                        </div>
                        <fieldset>
                            <legend>Choices</legend>
                            <DialogChoiceListEditor Items="EnsureNestedChoices(index)" ParentQuestId="@GetEffectiveQuestId(index)" OnChanged="OnChanged" />
                        </fieldset>
                        <div class="row-actions">
                            <button class="danger" @onclick="() => RemoveNestedDialog(index)">Remove Response</button>
                        </div>
                    }
                </fieldset>

                <div class="row-actions">
                    <button class="danger" @onclick="() => RemoveAt(index)">Remove Choice</button>
                </div>
            </div>
        }
    }

    <button @onclick="Add">+ Add Choice</button>
</div>

@code {
    [Parameter] public List<Choice> Items { get; set; } = new();
    [Parameter] public string? ParentQuestId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<string> MapOptions => MapReferenceOptions.GetMapOptions(Data.Maps);

    protected override void OnParametersSet()
    {
        NormalizeNextQuestStages(Items, ParentQuestId);
    }

    private async Task Add()
    {
        Items.Add(new Choice
        {
            Text = "New choice",
            Actions = new List<QuestAction>(),
            Items = new List<string>()
        });
        await OnChanged.InvokeAsync();
    }

    private async Task UpdateAt(int index, Action<Choice> mutate)
    {
        if (index < 0 || index >= Items.Count)
        {
            return;
        }

        mutate(Items[index]);
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAt(int index)
    {
        if (index < 0 || index >= Items.Count)
        {
            return;
        }

        Items.RemoveAt(index);
        await OnChanged.InvokeAsync();
    }

    private List<QuestAction> EnsureActions(int index) => Items[index].Actions ??= new List<QuestAction>();
    private List<string> EnsureItems(int index) => Items[index].Items ??= new List<string>();
    private List<Choice> EnsureNestedChoices(int index) => Items[index].Dialog.Choices ??= new List<Choice>();

    private async Task UpdateQuest(int index, string? questId)
    {
        await UpdateAt(index, choice =>
        {
            choice.Quest = string.IsNullOrWhiteSpace(questId) ? null : questId;
            var effectiveQuestId = GetEffectiveQuestId(choice);
            if (string.IsNullOrWhiteSpace(effectiveQuestId) ||
                !GetQuestStageNumbers(effectiveQuestId).Contains(choice.NextQuestStage ?? 0))
            {
                choice.NextQuestStage = null;
            }
        });
    }

    private async Task UpdateMap(int index, string? mapId)
    {
        await UpdateAt(index, choice =>
        {
            choice.MapId = string.IsNullOrWhiteSpace(mapId) ? null : mapId;
            if (!MapReferenceOptions.GetSpawnOptions(Data.Maps, choice.MapId).Contains(choice.SpawnId ?? string.Empty, StringComparer.OrdinalIgnoreCase))
            {
                choice.SpawnId = null;
            }
        });
    }

    private async Task UpdateNextQuestStage(int index, string? value)
    {
        await UpdateAt(index, choice =>
        {
            if (!int.TryParse(value, out var stage) || stage == 0)
            {
                choice.NextQuestStage = null;
                return;
            }

            choice.NextQuestStage = stage;
        });
    }

    private string? GetEffectiveQuestId(int index) =>
        index >= 0 && index < Items.Count ? GetEffectiveQuestId(Items[index]) : ParentQuestId;

    private string? GetEffectiveQuestId(Choice choice) =>
        string.IsNullOrWhiteSpace(choice.Quest) ? ParentQuestId : choice.Quest;

    private string NextQuestStageValue(int index)
    {
        var value = Items[index].NextQuestStage ?? 0;
        return value == 0 ? string.Empty : value.ToString();
    }

    private IReadOnlyList<int> GetQuestStageNumbers(string? questId)
    {
        if (string.IsNullOrWhiteSpace(questId))
        {
            return Array.Empty<int>();
        }

        var stages = Data.Quests
            .FirstOrDefault(quest => string.Equals(quest.Id, questId, StringComparison.OrdinalIgnoreCase))
            ?.Stages?
            .Select(stage => stage.Number)
            .Distinct()
            .OrderBy(stage => stage)
            .ToList();

        return stages ?? (IReadOnlyList<int>)Array.Empty<int>();
    }

    private IReadOnlyList<string> GetSpawnOptions(string? mapReference) =>
        MapReferenceOptions.GetSpawnOptions(Data.Maps, mapReference);

    private void NormalizeNextQuestStages(IEnumerable<Choice>? choices, string? parentQuestId)
    {
        if (choices == null)
        {
            return;
        }

        foreach (var choice in choices)
        {
            if (choice.NextQuestStage == 0)
            {
                choice.NextQuestStage = null;
            }

            var effectiveQuestId = string.IsNullOrWhiteSpace(choice.Quest) ? parentQuestId : choice.Quest;
            if (string.IsNullOrWhiteSpace(effectiveQuestId))
            {
                choice.NextQuestStage = null;
            }

            NormalizeNextQuestStages(choice.Dialog?.Choices, effectiveQuestId);
        }
    }

    private async Task OnActionsChanged(int index, List<QuestAction> actions)
    {
        if (index >= 0 && index < Items.Count)
        {
            Items[index].Actions = actions;
        }

        await Task.CompletedTask;
    }

    private async Task AddNestedDialog(int index)
    {
        if (index >= 0 && index < Items.Count)
        {
            Items[index].Dialog = new DialogText
            {
                Text = "New response",
                Choices = new List<Choice>()
            };
        }

        await OnChanged.InvokeAsync();
    }

    private async Task RemoveNestedDialog(int index)
    {
        if (index >= 0 && index < Items.Count)
        {
            Items[index].Dialog = null;
        }

        await OnChanged.InvokeAsync();
    }
}

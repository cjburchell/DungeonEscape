@*
    Image selector for a grid-based tileset (items / spells). The selected
    entity form is responsible for rendering its main preview.
*@

<div class="field-grid">
    <div class="field">
        <label>@Label</label>
        <select value="@ImageId" @onchange="OnImageChanged">
            @if (!Catalog.TryGet(ImageId, out _))
            {
                <option value="@ImageId">#@ImageId (unknown)</option>
            }
            @foreach (var entry in Catalog.Entries)
            {
                <option value="@entry.ImageId">@entry.DisplayName</option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Image";
    [Parameter] public TilesetImageCatalog Catalog { get; set; } = default!;
    [Parameter] public int ImageId { get; set; }
    [Parameter] public EventCallback<int> ImageIdChanged { get; set; }

    private async Task OnImageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            ImageId = id;
            await ImageIdChanged.InvokeAsync(id);
        }
    }
}

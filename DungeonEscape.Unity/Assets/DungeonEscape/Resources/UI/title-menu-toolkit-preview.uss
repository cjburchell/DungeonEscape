.title-menu-toolkit-preview {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 320px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.72);
}

.title-menu-toolkit-active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: black;
    background-size: cover;
    background-position: center;
    overflow: hidden;
}

.title-menu-toolkit-load-active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: black;
    background-size: cover;
    background-position: center;
}

.title-menu__button,
.title-menu__button--selected,
.title-load-menu__load,
.title-load-menu__load--selected,
.title-load-menu__delete,
.title-load-menu__delete--selected,
.title-load-menu__back,
.title-load-menu__back--selected {
    margin-bottom: 8px;
    min-height: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgba(20, 20, 20, 0.92);
}

.title-menu__items {
    position: absolute;
    left: 0;
    top: 0;
    width: 280px;
    margin-left: 0;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.72);
}

.title-load-menu__row {
    flex-direction: row;
}

.title-load-menu__panel {
    width: 640px;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.72);
}

.title-load-menu__load,
.title-load-menu__load--selected {
    flex-grow: 1;
}

.title-load-menu__delete,
.title-load-menu__delete--selected {
    margin-left: 8px;
    width: 92px;
}

.title-menu__button--selected,
.title-load-menu__load--selected,
.title-load-menu__delete--selected,
.title-load-menu__back--selected {
    color: black;
    background-color: rgba(255, 242, 51, 0.95);
}

.title-toolkit-button-label,
.title-toolkit-button-label--selected {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 16px;
}

.title-toolkit-button-label {
    color: white;
}

.title-toolkit-button-label--selected {
    color: black;
}

@*
    Property editor for a single monster. Mutates the bound Monster instance
    directly and raises OnChanged so the parent can flag the document dirty.
*@
@inject MonsterImageCatalog ImageCatalog
@inject DataSourceCatalog DataSources

@if (Monster == null)
{
    <div class="empty-state">Select a monster from the list, or add a new one.</div>
}
else
{
    <div class="form-header">
        <img class="preview" src="@PreviewSource" alt="preview" />
        <div class="field" style="flex:1">
            <label>Name</label>
            <input value="@Monster.Name" @onchange="e => SetName(e.Value?.ToString())" />
        </div>
    </div>

    <div class="field-grid">
        <div class="field">
            <label>Image</label>
            <div class="image-picker">
                <div class="field image-picker-field">
                    <div class="image-dropdown @(imageDropdownOpen ? "open" : null)">
                        <button type="button" class="image-dropdown-button" @onclick="ToggleImageDropdown">
                            <ImageDropdownRow ImageSource="@PreviewSource" Text="@SelectedImageDisplayName" />
                            <span class="image-dropdown-caret">▾</span>
                        </button>
                        @if (imageDropdownOpen)
                        {
                            <div class="image-dropdown-menu">
                        @if (!ImageCatalog.TryGet(Monster.ImageId, out _))
                        {
                                    <button type="button" class="image-dropdown-option selected" @onclick="() => SelectImage(Monster.ImageId)">
                                        <ImageDropdownRow ImageSource="@PreviewSource" Text="@UnknownImageDisplayName" />
                                    </button>
                        }
                        @foreach (var entry in ImageCatalog.Entries)
                        {
                                    <button type="button"
                                            class="image-dropdown-option @(entry.ImageId == Monster.ImageId ? "selected" : null)"
                                            @onclick="() => SelectImage(entry.ImageId)">
                                        <ImageDropdownRow ImageSource="@ImageCatalog.GetImageDataUri(entry.ImageId)" Text="@entry.DisplayName" />
                                    </button>
                        }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="field">
            <label>Rarity</label>
            <select value="@Monster.Rarity" @onchange="OnRarityChanged">
                @foreach (var rarity in Enum.GetValues<Rarity>())
                {
                    <option value="@rarity">@rarity</option>
                }
            </select>
        </div>

        <NumberField Label="Min Level" Value="Monster.MinLevel" ValueChanged="v => Set(() => Monster.MinLevel = v)" />
        <NumberField Label="Group Size" Value="Monster.GroupSize" ValueChanged="v => Set(() => Monster.GroupSize = v)" />
        <NumberField Label="Gold" Value="Monster.Gold" ValueChanged="v => Set(() => Monster.Gold = v)" />
        <NumberField Label="XP" Value="@((long)Monster.Xp)" ValueChanged="v => Set(() => Monster.Xp = (ulong)Math.Max(0, v))" />
    </div>

    <fieldset>
        <legend>Combat Stats</legend>
        <div class="field-grid">
            <NumberField Label="Attack" Value="Monster.Attack" ValueChanged="v => Set(() => Monster.Attack = v)" />
            <NumberField Label="Defence" Value="Monster.Defence" ValueChanged="v => Set(() => Monster.Defence = v)" />
            <NumberField Label="Magic Defence" Value="Monster.MagicDefence" ValueChanged="v => Set(() => Monster.MagicDefence = v)" />
            <NumberField Label="Agility" Value="Monster.Agility" ValueChanged="v => Set(() => Monster.Agility = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Health <RollPreview Label="Health" Times="Monster.HealthTimes" Random="Monster.HealthRandom" Const="Monster.HealthConst" /></legend>
        <div class="field-grid">
            <NumberField Label="Health Const" Value="Monster.HealthConst" ValueChanged="v => Set(() => Monster.HealthConst = v)" />
            <NumberField Label="Health Random" Value="Monster.HealthRandom" ValueChanged="v => Set(() => Monster.HealthRandom = v)" />
            <NumberField Label="Health Times" Value="Monster.HealthTimes" ValueChanged="v => Set(() => Monster.HealthTimes = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Magic <RollPreview Label="Magic" Times="Monster.MagicTimes" Random="Monster.MagicRandom" Const="Monster.MagicConst" /></legend>
        <div class="field-grid">
            <NumberField Label="Magic Const" Value="Monster.MagicConst" ValueChanged="v => Set(() => Monster.MagicConst = v)" />
            <NumberField Label="Magic Random" Value="Monster.MagicRandom" ValueChanged="v => Set(() => Monster.MagicRandom = v)" />
            <NumberField Label="Magic Times" Value="Monster.MagicTimes" ValueChanged="v => Set(() => Monster.MagicTimes = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Biomes</legend>
        <EnumMultiSelect TEnum="Biome" Selected="Monster.Biomes" SelectedChanged="OnBiomesChanged"
                         Exclude="ExcludedBiomes" OnChanged="RaiseChanged" />
    </fieldset>


    <fieldset>
        <legend>Spells</legend>
        <StringListEditor Items="EnsureList(Monster.SpellList)" Options="DataSources.Spells" OnChanged="RaiseChanged" />
    </fieldset>

    <fieldset>
        <legend>Skills</legend>
        <StringListEditor Items="EnsureList(Monster.SkillList)" Options="DataSources.Skills" OnChanged="RaiseChanged" />
    </fieldset>

    <fieldset>
        <legend>Items (drops)</legend>
        <StringListEditor Items="EnsureList(Monster.Items)" Options="DataSources.Items" OnChanged="RaiseChanged" />
    </fieldset>
}

@code {
    [Parameter] public Monster? Monster { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly Biome[] ExcludedBiomes = { Biome.None };

    private bool imageDropdownOpen;


    private string PreviewSource =>
        Monster == null
            ? string.Empty
            : ImageCatalog.GetImageDataUri(Monster.ImageId) ?? string.Empty;

    private string UnknownImageDisplayName => Monster == null ? string.Empty : $"#{Monster.ImageId} (unknown)";

    private string SelectedImageDisplayName =>
        Monster == null
            ? string.Empty
            : ImageCatalog.GetDisplayName(Monster.ImageId);

    private List<string> EnsureList(List<string>? list) => list ?? new List<string>();

    private async Task SetName(string? value)
    {
        if (Monster == null)
        {
            return;
        }

        Monster.Name = value ?? string.Empty;
        await RaiseChanged();
    }

    private void ToggleImageDropdown()
    {
        imageDropdownOpen = !imageDropdownOpen;
    }

    private async Task SelectImage(int id)
    {
        imageDropdownOpen = false;
        if (Monster != null)
        {
            Monster.ImageId = id;
            await RaiseChanged();
        }
    }

    private async Task OnRarityChanged(ChangeEventArgs e)
    {
        if (Monster != null && Enum.TryParse<Rarity>(e.Value?.ToString(), out var rarity))
        {
            Monster.Rarity = rarity;
            await RaiseChanged();
        }
    }

    private async Task OnBiomesChanged(List<Biome> biomes)
    {
        if (Monster != null)
        {
            Monster.Biomes = biomes;
        }

        await Task.CompletedTask;
    }

    private async Task Set(Action mutate)
    {
        mutate();
        await RaiseChanged();
    }

    private async Task RaiseChanged()
    {
        await OnChanged.InvokeAsync();
    }
}

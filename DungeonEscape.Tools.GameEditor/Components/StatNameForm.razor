@*
    Property editor for statnames.json entries: stat type plus optional prefix and
    suffix pools.
*@

@if (StatName == null)
{
    <div class="empty-state">Select a stat name entry from the list.</div>
}
else
{
    <div class="card-row-title">
        <span>@StatName.Type</span>
    </div>

    <fieldset>
        <legend>Prefixes</legend>
        <StringListEditor Items="EnsurePrefix()" OnChanged="RaiseChanged" />
    </fieldset>

    <fieldset>
        <legend>Suffixes</legend>
        <StringListEditor Items="EnsureSuffix()" OnChanged="RaiseChanged" />
    </fieldset>
}

@code {
    [Parameter] public StatName? StatName { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<string> EnsurePrefix() => StatName == null ? new List<string>() : (StatName.Prefix ??= new List<string>());
    private List<string> EnsureSuffix() => StatName == null ? new List<string>() : (StatName.Suffix ??= new List<string>());

    private async Task RaiseChanged() => await OnChanged.InvokeAsync();
}

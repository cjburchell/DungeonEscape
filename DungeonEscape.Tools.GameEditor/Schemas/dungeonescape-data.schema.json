{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeonescape.local/schemas/dungeonescape-data.schema.json",
  "title": "Dungeon Escape data definitions",
  "type": "object",
  "$defs": {
    "rarity": { "type": "string", "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary"] },
    "biome": { "type": "string", "enum": ["None", "Grassland", "Forest", "Water", "Hills", "Desert", "Swamp", "Cave", "Town", "Tower"] },
    "statType": { "type": "string", "enum": ["None", "HP", "Attack", "Defence", "MagicDefence", "Agility", "Magic"] },
    "target": { "type": "string", "enum": ["Single", "Group", "Object", "None"] },
    "skillType": { "type": "string", "enum": ["Heal", "Outside", "Damage", "Return", "Revive", "Dot", "Decrease", "Steal", "Attack", "None", "Disengage", "Open", "RemoveCondition", "AbilityModifier"] },
    "durationType": { "type": "string", "enum": ["Distance", "Rounds"] },
    "itemType": { "type": "string", "enum": ["OneUse", "Weapon", "Armor", "Gold", "Quest", "Unknown", "RepeatableUse"] },
    "slot": { "type": "string", "enum": ["OffHand", "PrimaryHand", "Hands", "Head", "Chest", "Legs", "Feet"] },
    "questAction": { "type": "string", "enum": ["None", "GiveItem", "TakeItem", "Fight", "Warp", "Join", "OpenDoor"] },
    "className": { "type": "string", "minLength": 1 },
    "dndSkillName": {
      "type": "string",
      "enum": [
        "Acrobatics",
        "Animal Handling",
        "Arcana",
        "Athletics",
        "Deception",
        "History",
        "Insight",
        "Intimidation",
        "Investigation",
        "Medicine",
        "Nature",
        "Perception",
        "Performance",
        "Persuasion",
        "Religion",
        "Sleight of Hand",
        "Stealth",
        "Survival"
      ]
    },
    "statRoll": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Type": { "$ref": "#/$defs/statType" },
        "Roll": { "type": "integer" },
        "RollTimes": { "type": "integer" },
        "StartConst": { "type": "integer" }
      }
    },
    "statValue": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Type": { "$ref": "#/$defs/statType" },
        "Value": { "type": "integer" }
      }
    },
    "monsterTrait": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" }
      }
    },
    "monsterAction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Item": { "type": "string" },
        "AttackBonus": { "type": "integer" },
        "DamageDice": { "type": "integer", "minimum": 0 },
        "DamageDie": { "type": "integer", "minimum": 0 },
        "DamageBonus": { "type": "integer" },
        "DamageType": { "type": "string" },
        "Reach": { "type": "string" },
        "Range": { "type": "string" },
        "Count": { "type": "integer", "minimum": 0 }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "ImageId": { "type": "integer", "minimum": 0 },
        "MinLevel": { "type": "integer", "minimum": 0 },
        "GroupSize": { "type": "integer", "minimum": 0 },
        "Items": { "type": "array", "items": { "type": "string" } },
        "Biomes": { "type": "array", "items": { "$ref": "#/$defs/biome" } },
        "Rarity": { "$ref": "#/$defs/rarity" },
        "Strength": { "type": "integer" },
        "Dexterity": { "type": "integer" },
        "Constitution": { "type": "integer" },
        "Intelligence": { "type": "integer" },
        "Wisdom": { "type": "integer" },
        "Charisma": { "type": "integer" },
        "ArmorClass": { "type": "integer", "minimum": 0 },
        "HitPoints": { "type": "integer", "minimum": 0 },
        "ProficiencyBonus": { "type": "integer" },
        "AttackBonus": { "type": "integer" },
        "DamageDice": { "type": "integer", "minimum": 0 },
        "DamageDie": { "type": "integer", "minimum": 0 },
        "DamageBonus": { "type": "integer" },
        "ChallengeRating": { "type": "string" },
        "DndMonster": { "type": "string" },
        "Size": { "type": "string" },
        "MonsterType": { "type": "string" },
        "Alignment": { "type": "string" },
        "Speed": { "type": "string" },
        "Senses": { "type": "string" },
        "Languages": { "type": "string" },
        "HitDice": { "type": "string" },
        "Traits": { "type": "array", "items": { "$ref": "#/$defs/monsterTrait" } },
        "Actions": { "type": "array", "items": { "$ref": "#/$defs/monsterAction" } }
      }
    },
    "spell": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "Skill": { "type": "string" },
        "ImageId": { "type": "integer", "minimum": 0 },
        "SpellLevel": { "type": "integer", "minimum": 1, "maximum": 9 },
        "School": { "type": "string" },
        "DndSpell": { "type": "string" },
        "MinLevel": { "type": "integer", "minimum": 0 },
        "Classes": { "type": "array", "items": { "$ref": "#/$defs/className" } }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "Targets": { "$ref": "#/$defs/target" },
        "Type": { "$ref": "#/$defs/skillType" },
        "DurationType": { "$ref": "#/$defs/durationType" },
        "StatType": { "$ref": "#/$defs/statType" },
        "MaxTargets": { "type": "integer", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Name"],
      "properties": {
        "Id": { "type": "string" },
        "Name": { "type": "string", "minLength": 1 },
        "ImageId": { "type": "integer", "minimum": 0 },
        "QuestId": { "type": "string" },
        "Skill": { "type": "string" },
        "Slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
        "Type": { "$ref": "#/$defs/itemType" },
        "Rarity": { "$ref": "#/$defs/rarity" },
        "Stats": { "type": "array", "items": { "$ref": "#/$defs/statValue" } },
        "Classes": { "type": "array", "items": { "$ref": "#/$defs/className" } },
        "DamageDice": { "type": "integer", "minimum": 0 },
        "DamageDie": { "type": "integer", "minimum": 0 },
        "DamageBonus": { "type": "integer" },
        "Target": { "$ref": "#/$defs/target" }
      }
    },
    "questStage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Number": { "type": "integer", "minimum": 0 },
        "Description": { "type": "string" },
        "CompleteQuest": { "type": "boolean" }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Id"],
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "MinimumLevel": { "type": "integer", "minimum": 0 },
        "Items": { "type": "array", "items": { "type": "string" } },
        "Stages": { "type": "array", "items": { "$ref": "#/$defs/questStage" } }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Text": { "type": "string" },
        "Actions": { "type": "array", "items": { "$ref": "#/$defs/questAction" } },
        "Items": { "type": "array", "items": { "type": "string" } },
        "ItemId": { "type": "string" },
        "Quest": { "type": "string" },
        "Monster": { "type": "string" },
        "NextQuestStage": { "type": "integer" },
        "MapId": { "type": "string" },
        "SpawnId": { "type": "string" },
        "ObjectId": { "type": "integer" },
        "Dialog": { "$ref": "#/$defs/dialogText" }
      }
    },
    "dialogText": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Text": { "type": "string" },
        "Choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
      }
    },
    "dialogHead": {
      "allOf": [
        { "$ref": "#/$defs/dialogText" },
        {
          "type": "object",
          "properties": {
            "Quest": { "type": "string" },
            "QuestStage": { "type": "array", "items": { "type": "integer" } },
            "ForQuestStage": { "type": "array", "items": { "type": "integer" } },
            "StartQuest": { "type": "boolean" }
          }
        }
      ]
    },
    "dialog": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Id"],
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "Dialogs": { "type": "array", "items": { "$ref": "#/$defs/dialogHead" } }
      }
    },
    "classStats": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Class"],
      "properties": {
        "Class": { "$ref": "#/$defs/className" },
        "PrimaryAbility": { "type": "string" },
        "HitDie": { "type": "integer", "minimum": 0 },
        "DefaultImage": { "type": "integer", "minimum": 0 },
        "Stats": { "type": "array", "items": { "$ref": "#/$defs/statRoll" } },
        "SkillProficiencies": { "type": "array", "items": { "$ref": "#/$defs/dndSkillName" } }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Male": { "type": "array", "items": { "type": "string" } },
        "Female": { "type": "array", "items": { "type": "string" } }
      }
    },
    "randomMonster": {
      "type": "object",
      "additionalProperties": true,
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "Rarity": { "$ref": "#/$defs/rarity" }
      }
    }
  }
}

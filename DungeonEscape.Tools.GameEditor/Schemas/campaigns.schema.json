{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dungeon Escape installed campaign index",
  "type": "object",
  "required": ["SchemaVersion", "DefaultCampaignId", "Manifests"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "DefaultCampaignId": { "type": "string", "pattern": "^campaign/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Manifests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^Assets/DungeonEscape/Data/.+\\.json$" }
    }
  }
}

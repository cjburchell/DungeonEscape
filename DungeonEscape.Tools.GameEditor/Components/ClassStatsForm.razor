@*
    Property editor for classlevels.json entries: one class, its D&D metadata,
    default hero image, and skill proficiency references.
*@

@if (ClassStats == null)
{
    <div class="empty-state">Select a class from the list, or add a new one.</div>
}
else
{
    <div class="form-header">
        <div class="field-grid" style="flex:1">
            <div class="field">
                <label>Class</label>
                <input value="@ClassStats.Class" @onchange="e => Set(() => ClassStats.Class = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <div class="field">
                <label>Primary Ability</label>
                <input value="@ClassStats.PrimaryAbility" @onchange="e => Set(() => ClassStats.PrimaryAbility = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <NumberField Label="Hit Die" Value="ClassStats.HitDie" ValueChanged="v => Set(() => ClassStats.HitDie = v)" />
        </div>
    </div>

    <HeroImagePicker Label="Default Image" ImageId="ClassStats.DefaultImage"
                     ImageIdChanged="id => Set(() => ClassStats.DefaultImage = id)" />

    <fieldset>
        <legend>Skill Proficiencies</legend>
        <StringListEditor Items="EnsureSkillProficiencies()" Options="DndSkills" OnChanged="RaiseChanged" />
    </fieldset>
}

@code {
    [Parameter] public ClassStats? ClassStats { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly IReadOnlyList<string> DndSkills = DndStatRules.GetDndSkillNames();

    private List<string> EnsureSkillProficiencies() =>
        ClassStats == null ? new List<string>() : (ClassStats.SkillProficiencies ??= new List<string>());

    private async Task Set(Action mutate)
    {
        mutate();
        await RaiseChanged();
    }

    private async Task RaiseChanged() => await OnChanged.InvokeAsync();
}

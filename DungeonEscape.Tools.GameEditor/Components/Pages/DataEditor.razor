@page "/"
@implements IDisposable
@inject DataFolderService Data
@inject MonsterImageCatalog MonsterImages
@inject ItemImageCatalog ItemImages
@inject SpellImageCatalog SpellImages
@inject HeroImageCatalog HeroImages
@inject DataSourceCatalog DataSources
@inject AssetContext Assets
@inject WindowService Window
@inject EditorSettingsService Settings
@inject DataValidationService Validator

<div class="toolbar">
    <div class="menu @(showFileMenu ? "open" : string.Empty)">
        <button class="menu-button" @onclick="ToggleFileMenu">File &#9662;</button>
        @if (showFileMenu)
        {
            <div class="menu-dropdown">
                <button class="menu-item" @onclick="OpenFolder">Open Folder&hellip;</button>
                <button class="menu-item" @onclick="SaveProject" disabled="@(!Data.HasDocument)">Save Project</button>
                <button class="menu-item" @onclick="ReloadProject" disabled="@(!Data.HasDocument)">Reload</button>
            </div>
        }
    </div>
    <span class="spacer"></span>

    <span class="file-name">
        @if (Data.HasDocument)
        {
            @Data.DisplayName
            @if (Data.IsDirty)
            {
                <span class="dirty"> &bull; unsaved</span>
            }
        }
        else
        {
            <text>No folder open</text>
        }
    </span>
</div>

@if (!Data.HasDocument)
{
    <div class="empty-state">
        <p>Open a Dungeon Escape <code>Data</code> folder to begin editing monsters, spells, skills and items.</p>
        <p><button @onclick="OpenFolder">Open Folder</button></p>
    </div>
}
else
{
    <div class="tabs">
        @foreach (var tab in Enum.GetValues<EditorTab>())
        {
            var current = tab;
            <button class="tab @(activeTab == current ? "active" : string.Empty)"
                    @onclick="() => SetTab(current)">
                @TabLabel(current) (@Count(current))
            </button>
        }
    </div>

    <div class="validation-panel @(showValidationPanel ? "open" : string.Empty)">
        <button class="validation-summary" @onclick="ToggleValidationPanel">
            Validation: @ValidationSummary
        </button>
        @if (showValidationPanel)
        {
            <div class="validation-list">
                @if (validationIssues.Count == 0)
                {
                    <div class="validation-empty">No validation issues.</div>
                }
                else
                {
                    @foreach (var issue in validationIssues)
                    {
                        <div class="validation-issue @issue.Severity.ToString().ToLowerInvariant()">
                            <span class="validation-severity">@issue.Severity</span>
                            <span class="validation-location">@issue.Location</span>
                            <span class="validation-message">@issue.Message</span>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="split">
        @if (!IsToolTab)
        {
        <div class="list-pane">
            <div class="search">
                <input placeholder="Search..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="list-actions">
                <button @onclick="AddItem" disabled="@AreListActionsDisabled">+ Add</button>
                <button @onclick="DuplicateItem" disabled="@(SelectedObject == null || AreListActionsDisabled)">Duplicate</button>
                <button class="danger" @onclick="RemoveItem" disabled="@(SelectedObject == null || AreListActionsDisabled)">Remove</button>
            </div>
            <div class="monster-list">
                @switch (activeTab)
                {
                    case EditorTab.Monsters:
                        @foreach (var monster in Filter(Data.Monsters, m => m.Name))
                        {
                            var current = monster;
                            <div class="monster-item @(ReferenceEquals(current, selectedMonster) ? "selected" : string.Empty)"
                                 @onclick="() => selectedMonster = current">
                                <img class="thumb" src="@MonsterThumb(current.ImageId)" alt="" />
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">Lvl @current.MinLevel &middot; @current.Rarity</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Spells:
                        @foreach (var spell in Filter(Data.Spells, s => s.Name))
                        {
                            var current = spell;
                            <div class="monster-item @(ReferenceEquals(current, selectedSpell) ? "selected" : string.Empty)"
                                 @onclick="() => selectedSpell = current">
                                <img class="thumb" src="@SpellThumb(current.ImageId)" alt="" />
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">Spell L@current.SpellLevel &middot; Min L@current.MinLevel</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Skills:
                        @foreach (var skill in Filter(Data.Skills, s => s.Name))
                        {
                            var current = skill;
                            <div class="monster-item @(ReferenceEquals(current, selectedSkill) ? "selected" : string.Empty)"
                                 @onclick="() => selectedSkill = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">@current.Type</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Items:
                        @foreach (var item in Filter(Data.Items, i => i.Name))
                        {
                            var current = item;
                            <div class="monster-item @(ReferenceEquals(current, selectedItem) ? "selected" : string.Empty)"
                                 @onclick="() => selectedItem = current">
                                <img class="thumb" src="@ItemThumb(current.ImageId)" alt="" />
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">@current.Type &middot; @current.Rarity</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Quests:
                        @foreach (var quest in Filter(Data.Quests, q => q.Name))
                        {
                            var current = quest;
                            <div class="monster-item @(ReferenceEquals(current, selectedQuest) ? "selected" : string.Empty)"
                                 @onclick="() => selectedQuest = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">@current.Id &middot; Lvl @current.MinimumLevel</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Dialogs:
                        @foreach (var dialog in Filter(Data.Dialogs, d => d.Id))
                        {
                            var current = dialog;
                            <div class="monster-item @(ReferenceEquals(current, selectedDialog) ? "selected" : string.Empty)"
                                 @onclick="() => selectedDialog = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Id)</span>
                                    <span class="sub">@(current.Dialogs?.Count ?? 0) heads</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Classes:
                        @foreach (var classStats in Filter(Data.ClassLevels, c => c.Class))
                        {
                            var current = classStats;
                            <div class="monster-item @(ReferenceEquals(current, selectedClassStats) ? "selected" : string.Empty)"
                                 @onclick="() => selectedClassStats = current">
                                <img class="thumb" src="@ClassThumb(current.DefaultImage)" alt="" />
                                <div class="meta">
                                    <span class="name">@current.Class</span>
                                    <span class="sub">d@current.HitDie hit die &middot; @(current.SkillProficiencies?.Count ?? 0) proficiencies</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Species:
                        @foreach (var species in Filter(Data.Species, s => s.Name))
                        {
                            var current = species;
                            <div class="monster-item @(ReferenceEquals(current, selectedSpecies) ? "selected" : string.Empty)"
                                 @onclick="() => selectedSpecies = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">@current.Species &middot; @(current.SkillProficiencies?.Count ?? 0) proficiencies</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Backgrounds:
                        @foreach (var background in Filter(Data.Backgrounds, b => b.Name))
                        {
                            var current = background;
                            <div class="monster-item @(ReferenceEquals(current, selectedBackground) ? "selected" : string.Empty)"
                                 @onclick="() => selectedBackground = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Name)</span>
                                    <span class="sub">@current.Id &middot; @(current.SkillProficiencies?.Count ?? 0) proficiencies</span>
                                </div>
                            </div>
                        }
                        break;
                    case EditorTab.Names:
                        <div class="empty-state">Names are edited as a single document.</div>
                        break;
                    case EditorTab.Maps:
                        @foreach (var map in Filter(Data.Maps, m => m.Id))
                        {
                            var current = map;
                            <div class="monster-item @(ReferenceEquals(current, selectedMap) ? "selected" : string.Empty)"
                                 @onclick="() => selectedMap = current">
                                <div class="meta">
                                    <span class="name">@Display(current.Id)</span>
                                    <span class="sub">@(current.Objects?.Count ?? 0) objects &middot; @(current.RandomMonsters?.Count ?? 0) monsters</span>
                                </div>
                            </div>
                        }
                        break;
                }
            </div>
        </div>
        }

        <div class="form-pane">
            @switch (activeTab)
            {
                case EditorTab.Monsters:
                    <MonsterForm Monster="selectedMonster" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Spells:
                    <SpellForm Spell="selectedSpell" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Skills:
                    <SkillForm Skill="selectedSkill" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Items:
                    <ItemForm Item="selectedItem" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Quests:
                    <QuestForm Quest="selectedQuest" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Dialogs:
                    <DialogForm Dialog="selectedDialog" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Classes:
                    <ClassStatsForm ClassStats="selectedClassStats" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Species:
                    <SpeciesForm SpeciesDefinition="selectedSpecies" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Backgrounds:
                    <BackgroundForm Background="selectedBackground" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Names:
                    <NamesForm Names="Data.Names" OnChanged="OnDataChanged" />
                    break;
                case EditorTab.Maps:
                    <MapForm Map="selectedMap" Maps="Data.Maps" OnChanged="OnMapChanged" />
                    break;
                case EditorTab.QuestGraph:
                    <QuestDialogGraph />
                    break;
                case EditorTab.EncounterSimulator:
                    <EncounterSimulator />
                    break;
            }
        </div>
    </div>
}

@if (toast != null)
{
    <div class="toast">@toast</div>
}

@code {
    private enum EditorTab { Monsters, Spells, Skills, Items, Quests, Dialogs, Classes, Species, Backgrounds, Names, Maps, QuestGraph, EncounterSimulator }

    private EditorTab activeTab = EditorTab.Monsters;
    private string searchText = string.Empty;
    private string? toast;
    private bool showFileMenu;
    private bool showValidationPanel = true;
    private IReadOnlyList<DataValidationIssue> validationIssues = Array.Empty<DataValidationIssue>();

    private Monster? selectedMonster;
    private Spell? selectedSpell;
    private Skill? selectedSkill;
    private Item? selectedItem;
    private Quest? selectedQuest;
    private Dialog? selectedDialog;
    private ClassStats? selectedClassStats;
    private SpeciesDefinition? selectedSpecies;
    private BackgroundDefinition? selectedBackground;
    private MapDocument? selectedMap;

    protected override void OnInitialized()
    {
        Data.StateChanged += OnStateChanged;
        Assets.Changed += OnStateChanged;

        TryAutoLoadLastFolder();
    }

    public void Dispose()
    {
        Data.StateChanged -= OnStateChanged;
        Assets.Changed -= OnStateChanged;
    }

    private void OnStateChanged()
    {
        RefreshValidation();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleFileMenu() => showFileMenu = !showFileMenu;
    private void CloseFileMenu() => showFileMenu = false;
    private void ToggleValidationPanel() => showValidationPanel = !showValidationPanel;

    private void TryAutoLoadLastFolder()
    {
        var path = Settings.LastDataFolder;
        if (string.IsNullOrEmpty(path) || !System.IO.Directory.Exists(path))
        {
            return;
        }

        try
        {
            Data.Load(path);
            ResetSelections();
            RefreshValidation();
            ShowToast($"Loaded {Data.Monsters.Count} monsters, {Data.Items.Count} items, {Data.Maps.Count} maps");
        }
        catch
        {
            // If the remembered folder can't be loaded, fall back to the empty state.
        }
    }

    private void OpenFolder()
    {
        CloseFileMenu();

        if (!ConfirmDiscardChanges())
        {
            return;
        }

        var startDir = Assets.DataDirectory ?? Data.FolderPath ?? Settings.LastDataFolder;
        var path = Window.ShowOpenFolder("Open Data Folder", startDir);
        if (string.IsNullOrEmpty(path))
        {
            return;
        }

        try
        {
            Data.Load(path);
            ResetSelections();
            Settings.LastDataFolder = Data.FolderPath;
            RefreshValidation();
            ShowToast($"Loaded {Data.Monsters.Count} monsters, {Data.Items.Count} items, {Data.Maps.Count} maps");
        }
        catch (Exception ex)
        {
            Window.ShowInfo("Open Failed", ex.Message);
        }
    }

    private void SaveProject()
    {
        CloseFileMenu();

        try
        {
            Data.Save();
            Settings.LastDataFolder = Data.FolderPath;
            RefreshValidation();
            ShowToast("Saved project");
        }
        catch (Exception ex)
        {
            Window.ShowInfo("Save Failed", ex.Message);
        }
    }

    private void ReloadProject()
    {
        CloseFileMenu();

        if (!ConfirmDiscardChanges())
        {
            return;
        }

        try
        {
            Data.Reload();
            ResetSelections();
            RefreshValidation();
            ShowToast("Reloaded");
        }
        catch (Exception ex)
        {
            Window.ShowInfo("Reload Failed", ex.Message);
        }
    }

    private void ResetSelections()
    {
        selectedMonster = Data.Monsters.FirstOrDefault();
        selectedSpell = Data.Spells.FirstOrDefault();
        selectedSkill = Data.Skills.FirstOrDefault();
        selectedItem = Data.Items.FirstOrDefault();
        selectedQuest = Data.Quests.FirstOrDefault();
        selectedDialog = Data.Dialogs.FirstOrDefault();
        selectedClassStats = Data.ClassLevels.FirstOrDefault();
        selectedSpecies = Data.Species.FirstOrDefault();
        selectedBackground = Data.Backgrounds.FirstOrDefault();
        selectedMap = Data.Maps.FirstOrDefault();
    }

    private void SetTab(EditorTab tab)
    {
        activeTab = tab;
        searchText = string.Empty;
    }

    private static string TabLabel(EditorTab tab) => tab switch
    {
        EditorTab.Classes => "Class",
        EditorTab.Species => "Species",
        EditorTab.Backgrounds => "Backgrounds",
        EditorTab.QuestGraph => "Quest Graph",
        EditorTab.EncounterSimulator => "Encounter Simulator",
        _ => tab.ToString()
    };

    private int Count(EditorTab tab) => tab switch
    {
        EditorTab.Monsters => Data.Monsters.Count,
        EditorTab.Spells => Data.Spells.Count,
        EditorTab.Skills => Data.Skills.Count,
        EditorTab.Items => Data.Items.Count,
        EditorTab.Quests => Data.Quests.Count,
        EditorTab.Dialogs => Data.Dialogs.Count,
        EditorTab.Classes => Data.ClassLevels.Count,
        EditorTab.Species => Data.Species.Count,
        EditorTab.Backgrounds => Data.Backgrounds.Count,
        EditorTab.Names => (Data.Names.Male?.Count ?? 0) + (Data.Names.Female?.Count ?? 0),
        EditorTab.Maps => Data.Maps.Count,
        EditorTab.QuestGraph => Data.Quests.Count + Data.Dialogs.Count,
        EditorTab.EncounterSimulator => Data.Maps.Count + 1,
        _ => 0
    };

    private bool IsSingleObjectTab => activeTab == EditorTab.Names;
    private bool IsMapTab => activeTab == EditorTab.Maps;
    private bool IsToolTab => activeTab == EditorTab.QuestGraph || activeTab == EditorTab.EncounterSimulator;
    private bool AreListActionsDisabled => IsSingleObjectTab || IsMapTab || IsToolTab;

    private object? SelectedObject => activeTab switch
    {
        EditorTab.Monsters => selectedMonster,
        EditorTab.Spells => selectedSpell,
        EditorTab.Skills => selectedSkill,
        EditorTab.Items => selectedItem,
        EditorTab.Quests => selectedQuest,
        EditorTab.Dialogs => selectedDialog,
        EditorTab.Classes => selectedClassStats,
        EditorTab.Species => selectedSpecies,
        EditorTab.Backgrounds => selectedBackground,
        EditorTab.Names => Data.Names,
        EditorTab.Maps => selectedMap,
        EditorTab.QuestGraph => null,
        EditorTab.EncounterSimulator => null,
        _ => null
    };

    private IEnumerable<T> Filter<T>(IEnumerable<T> source, Func<T, string?> nameSelector)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return source;
        }

        return source.Where(x =>
            (nameSelector(x) ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    private static string Display(string? name) => string.IsNullOrEmpty(name) ? "(unnamed)" : name;

    private string MonsterThumb(int imageId) => MonsterImages.GetImageDataUri(imageId) ?? string.Empty;

    private string ItemThumb(int imageId) => ItemImages.Catalog.GetImageDataUri(imageId) ?? string.Empty;

    private string SpellThumb(int imageId) => SpellImages.Catalog.GetImageDataUri(imageId) ?? string.Empty;

    private string ClassThumb(int imageId) => HeroImages.GetImageDataUri(imageId) ?? string.Empty;

    private void OnDataChanged() => Data.MarkDirty();

    private void OnMapChanged()
    {
        if (selectedMap != null)
        {
            selectedMap.IsDirty = true;
        }

        Data.MarkDirty();
    }

    private string ValidationSummary
    {
        get
        {
            var errorCount = validationIssues.Count(issue => issue.Severity == DataValidationSeverity.Error);
            var warningCount = validationIssues.Count(issue => issue.Severity == DataValidationSeverity.Warning);
            return errorCount == 0 && warningCount == 0
                ? "0 issues"
                : $"{errorCount} errors, {warningCount} warnings";
        }
    }

    private void RefreshValidation()
    {
        validationIssues = Data.HasDocument ? Validator.Validate() : Array.Empty<DataValidationIssue>();
    }

    private void AddItem()
    {
        switch (activeTab)
        {
            case EditorTab.Monsters:
                selectedMonster = new Monster { Name = "New Monster" };
                Data.Monsters.Add(selectedMonster);
                break;
            case EditorTab.Spells:
                selectedSpell = new Spell { Name = "New Spell", Classes = new List<string>() };
                Data.Spells.Add(selectedSpell);
                break;
            case EditorTab.Skills:
                selectedSkill = new Skill { Name = "New Skill" };
                Data.Skills.Add(selectedSkill);
                break;
            case EditorTab.Items:
                selectedItem = new Item { Name = "New Item" };
                Data.Items.Add(selectedItem);
                break;
            case EditorTab.Quests:
                selectedQuest = new Quest
                {
                    Id = "new-quest",
                    Name = "New Quest",
                    Description = string.Empty,
                    Items = new List<string>(),
                    Stages = new List<QuestStage>()
                };
                Data.Quests.Add(selectedQuest);
                break;
            case EditorTab.Dialogs:
                selectedDialog = new Dialog
                {
                    Id = "new-dialog",
                    Dialogs = new List<DialogHead>
                    {
                        new()
                        {
                            Text = "New dialog",
                            Choices = new List<Choice>(),
                            QuestStage = new List<int>()
                        }
                    }
                };
                Data.Dialogs.Add(selectedDialog);
                break;
            case EditorTab.Classes:
                selectedClassStats = new ClassStats
                {
                    Class = NextAvailableClass(),
                    DefaultImage = Data.ClassLevels.Count,
                    HitDie = 8,
                    SkillChoiceCount = 2,
                    SkillProficiencies = new List<string>(),
                    SkillOptions = DndStatRules.GetDndSkillNames().ToList()
                };
                Data.ClassLevels.Add(selectedClassStats);
                break;
            case EditorTab.Species:
                var species = NextAvailableSpecies();
                selectedSpecies = new SpeciesDefinition
                {
                    Species = species,
                    Name = species.ToString(),
                    SkillProficiencies = new List<string>()
                };
                Data.Species.Add(selectedSpecies);
                break;
            case EditorTab.Backgrounds:
                selectedBackground = new BackgroundDefinition
                {
                    Id = "NewBackground",
                    Name = "New Background",
                    SkillProficiencies = new List<string>()
                };
                Data.Backgrounds.Add(selectedBackground);
                break;
        }

        Data.MarkDirty();
    }

    private void DuplicateItem()
    {
        switch (activeTab)
        {
            case EditorTab.Monsters when selectedMonster != null:
                selectedMonster = Clone(selectedMonster, Data.Monsters, m => m.Name, (m, n) => m.Name = n);
                break;
            case EditorTab.Spells when selectedSpell != null:
                selectedSpell = Clone(selectedSpell, Data.Spells, s => s.Name, (s, n) => s.Name = n);
                break;
            case EditorTab.Skills when selectedSkill != null:
                selectedSkill = Clone(selectedSkill, Data.Skills, s => s.Name, (s, n) => s.Name = n);
                break;
            case EditorTab.Items when selectedItem != null:
                selectedItem = Clone(selectedItem, Data.Items, i => i.Name, (i, n) => i.Name = n);
                break;
            case EditorTab.Quests when selectedQuest != null:
                selectedQuest = Clone(selectedQuest, Data.Quests, q => q.Name, (q, n) => q.Name = n);
                selectedQuest.Id = UniqueId(
                    string.IsNullOrWhiteSpace(selectedQuest.Id) ? "quest-copy" : selectedQuest.Id + "-copy",
                    Data.Quests.Where(quest => !ReferenceEquals(quest, selectedQuest)).Select(quest => quest.Id));
                break;
            case EditorTab.Dialogs when selectedDialog != null:
                selectedDialog = Clone(selectedDialog, Data.Dialogs, d => d.Id, (d, n) => d.Id = UniqueId(n, Data.Dialogs.Select(existing => existing.Id)));
                break;
            case EditorTab.Classes when selectedClassStats != null:
                selectedClassStats = Clone(selectedClassStats, Data.ClassLevels, c => c.Class, (_, _) => { });
                selectedClassStats.Class = NextAvailableClass(selectedClassStats.Class);
                break;
            case EditorTab.Species when selectedSpecies != null:
                selectedSpecies = Clone(selectedSpecies, Data.Species, s => s.Name, (s, n) => s.Name = n);
                selectedSpecies.Species = NextAvailableSpecies(selectedSpecies.Species);
                break;
            case EditorTab.Backgrounds when selectedBackground != null:
                selectedBackground = Clone(selectedBackground, Data.Backgrounds, b => b.Name, (b, n) => b.Name = n);
                selectedBackground.Id = UniqueId(
                    string.IsNullOrWhiteSpace(selectedBackground.Id) ? "BackgroundCopy" : selectedBackground.Id + "Copy",
                    Data.Backgrounds.Where(background => !ReferenceEquals(background, selectedBackground)).Select(background => background.Id));
                break;
        }

        Data.MarkDirty();
    }

    private static T Clone<T>(T source, List<T> list, Func<T, string?> getName, Action<T, string> setName)
    {
        var json = Newtonsoft.Json.JsonConvert.SerializeObject(source);
        var clone = Newtonsoft.Json.JsonConvert.DeserializeObject<T>(json)!;
        var name = getName(source);
        setName(clone, string.IsNullOrEmpty(name) ? "Copy" : name + " (Copy)");

        var index = list.IndexOf(source);
        if (index >= 0)
        {
            list.Insert(index + 1, clone);
        }
        else
        {
            list.Add(clone);
        }

        return clone;
    }

    private string NextAvailableClass(string? fallback = null)
    {
        var usedClasses = Data.ClassLevels
            .Where(classStats => !ReferenceEquals(classStats, selectedClassStats))
            .Select(classStats => classStats.Class)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var candidate in Redpoint.DungeonEscape.Rules.DndCharacterRules.GetPlayableClasses())
        {
            var className = candidate.ToString();
            if (!usedClasses.Contains(className))
            {
                return className;
            }
        }

        return string.IsNullOrWhiteSpace(fallback) ? "NewClass" : fallback;
    }

    private Species NextAvailableSpecies(Species? fallback = null)
    {
        var usedSpecies = Data.Species
            .Where(species => !ReferenceEquals(species, selectedSpecies))
            .Select(species => species.Species)
            .ToHashSet();

        foreach (var candidate in Enum.GetValues<Species>())
        {
            if (!usedSpecies.Contains(candidate))
            {
                return candidate;
            }
        }

        return fallback ?? Species.Human;
    }

    private static string UniqueId(string baseId, IEnumerable<string?> existingIds)
    {
        var root = string.IsNullOrWhiteSpace(baseId) ? "copy" : baseId.Trim();
        var existing = existingIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!existing.Contains(root))
        {
            return root;
        }

        for (var index = 2; ; index++)
        {
            var candidate = $"{root}-{index}";
            if (!existing.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    private void RemoveItem()
    {
        var name = activeTab switch
        {
            EditorTab.Monsters => selectedMonster?.Name,
            EditorTab.Spells => selectedSpell?.Name,
            EditorTab.Skills => selectedSkill?.Name,
            EditorTab.Items => selectedItem?.Name,
            EditorTab.Quests => selectedQuest?.Name,
            EditorTab.Dialogs => selectedDialog?.Id,
            EditorTab.Classes => selectedClassStats?.Class,
            EditorTab.Backgrounds => selectedBackground?.Name,
            EditorTab.Maps => selectedMap?.Id,
            _ => null
        };

        if (SelectedObject == null)
        {
            return;
        }

        var result = Window.ShowConfirm("Remove", $"Remove '{name}' from the list?");
        if (result != Photino.NET.PhotinoDialogResult.Yes)
        {
            return;
        }

        switch (activeTab)
        {
            case EditorTab.Monsters when selectedMonster != null:
                Data.Monsters.Remove(selectedMonster);
                selectedMonster = Data.Monsters.FirstOrDefault();
                break;
            case EditorTab.Spells when selectedSpell != null:
                Data.Spells.Remove(selectedSpell);
                selectedSpell = Data.Spells.FirstOrDefault();
                break;
            case EditorTab.Skills when selectedSkill != null:
                Data.Skills.Remove(selectedSkill);
                selectedSkill = Data.Skills.FirstOrDefault();
                break;
            case EditorTab.Items when selectedItem != null:
                Data.Items.Remove(selectedItem);
                selectedItem = Data.Items.FirstOrDefault();
                break;
            case EditorTab.Quests when selectedQuest != null:
                Data.Quests.Remove(selectedQuest);
                selectedQuest = Data.Quests.FirstOrDefault();
                break;
            case EditorTab.Dialogs when selectedDialog != null:
                Data.Dialogs.Remove(selectedDialog);
                selectedDialog = Data.Dialogs.FirstOrDefault();
                break;
            case EditorTab.Classes when selectedClassStats != null:
                Data.ClassLevels.Remove(selectedClassStats);
                selectedClassStats = Data.ClassLevels.FirstOrDefault();
                break;
            case EditorTab.Species when selectedSpecies != null:
                Data.Species.Remove(selectedSpecies);
                selectedSpecies = Data.Species.FirstOrDefault();
                break;
            case EditorTab.Backgrounds when selectedBackground != null:
                Data.Backgrounds.Remove(selectedBackground);
                selectedBackground = Data.Backgrounds.FirstOrDefault();
                break;
        }

        Data.MarkDirty();
    }

    private bool ConfirmDiscardChanges()
    {
        if (!Data.IsDirty)
        {
            return true;
        }

        var result = Window.ShowConfirm("Unsaved Changes",
            "You have unsaved changes. Save before continuing?");

        switch (result)
        {
            case Photino.NET.PhotinoDialogResult.Yes:
                SaveProject();
                return !Data.IsDirty;
            case Photino.NET.PhotinoDialogResult.No:
                return true;
            default:
                return false;
        }
    }

    private void ShowToast(string message)
    {
        toast = message;
        _ = HideToastLater();
    }

    private async Task HideToastLater()
    {
        await Task.Delay(2000);
        toast = null;
        await InvokeAsync(StateHasChanged);
    }
}

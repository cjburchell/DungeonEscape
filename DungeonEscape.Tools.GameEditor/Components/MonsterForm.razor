@*
    Property editor for a single monster. Mutates the bound Monster instance
    directly and raises OnChanged so the parent can flag the document dirty.
*@
@inject MonsterImageCatalog ImageCatalog
@inject DataSourceCatalog DataSources

@if (Monster == null)
{
    <div class="empty-state">Select a monster from the list, or add a new one.</div>
}
else
{
    <div class="form-header">
        <img class="preview" src="@PreviewSource" alt="preview" />
        <div class="field" style="flex:1">
            <label>Name</label>
            <input value="@Monster.Name" @onchange="e => SetName(e.Value?.ToString())" />
        </div>
    </div>

    <div class="field-grid">
        <div class="field">
            <label>Image</label>
            <div class="image-picker">
                <div class="field image-picker-field">
                    <div class="image-dropdown @(imageDropdownOpen ? "open" : null)">
                        <button type="button" class="image-dropdown-button" @onclick="ToggleImageDropdown">
                            <ImageDropdownRow ImageSource="@PreviewSource" Text="@SelectedImageDisplayName" />
                            <span class="image-dropdown-caret">▾</span>
                        </button>
                        @if (imageDropdownOpen)
                        {
                            <div class="image-dropdown-menu">
                        @if (!ImageCatalog.TryGet(Monster.ImageId, out _))
                        {
                                    <button type="button" class="image-dropdown-option selected" @onclick="() => SelectImage(Monster.ImageId)">
                                        <ImageDropdownRow ImageSource="@PreviewSource" Text="@UnknownImageDisplayName" />
                                    </button>
                        }
                        @foreach (var entry in ImageCatalog.Entries)
                        {
                                    <button type="button"
                                            class="image-dropdown-option @(entry.ImageId == Monster.ImageId ? "selected" : null)"
                                            @onclick="() => SelectImage(entry.ImageId)">
                                        <ImageDropdownRow ImageSource="@ImageCatalog.GetImageDataUri(entry.ImageId)" Text="@entry.DisplayName" />
                                    </button>
                        }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="field">
            <label>Rarity</label>
            <select value="@Monster.Rarity" @onchange="OnRarityChanged">
                @foreach (var rarity in Enum.GetValues<Rarity>())
                {
                    <option value="@rarity">@rarity</option>
                }
            </select>
        </div>

        <NumberField Label="Min Level" Value="Monster.MinLevel" ValueChanged="v => Set(() => Monster.MinLevel = v)" />
        <NumberField Label="Group Size" Value="Monster.GroupSize" ValueChanged="v => Set(() => Monster.GroupSize = v)" />
        <NumberField Label="Gold" Value="Monster.Gold" ValueChanged="v => Set(() => Monster.Gold = v)" />
        <NumberField Label="XP" Value="@((long)Monster.Xp)" ValueChanged="v => Set(() => Monster.Xp = (ulong)Math.Max(0, v))" />
        <div class="field">
            <label>Challenge Rating</label>
            <input value="@Monster.ChallengeRating" @onchange="e => Set(() => Monster.ChallengeRating = e.Value?.ToString())" />
        </div>
        <div class="field">
            <label>D&amp;D Monster</label>
            <input value="@Monster.DndMonster" @onchange="e => Set(() => Monster.DndMonster = e.Value?.ToString())" />
        </div>
    </div>

    <fieldset>
        <legend>D&amp;D Identity</legend>
        <div class="field-grid">
            <div class="field">
                <label>Size</label>
                <input value="@Monster.Size" @onchange="e => Set(() => Monster.Size = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Type</label>
                <input value="@Monster.MonsterType" @onchange="e => Set(() => Monster.MonsterType = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Alignment</label>
                <input value="@Monster.Alignment" @onchange="e => Set(() => Monster.Alignment = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Speed</label>
                <input value="@Monster.Speed" @onchange="e => Set(() => Monster.Speed = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Senses</label>
                <input value="@Monster.Senses" @onchange="e => Set(() => Monster.Senses = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Languages</label>
                <input value="@Monster.Languages" @onchange="e => Set(() => Monster.Languages = e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Hit Dice</label>
                <input value="@Monster.HitDice" @onchange="e => Set(() => Monster.HitDice = e.Value?.ToString())" />
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>D&amp;D Combat</legend>
        <div class="field-grid">
            <NumberField Label="Armor Class" Value="Monster.ArmorClass" ValueChanged="v => Set(() => Monster.ArmorClass = v)" />
            <NumberField Label="Proficiency" Value="Monster.ProficiencyBonus" ValueChanged="v => Set(() => Monster.ProficiencyBonus = v)" />
            <NumberField Label="Attack Bonus" Value="Monster.AttackBonus" ValueChanged="v => Set(() => Monster.AttackBonus = v)" />
            <NumberField Label="Damage Dice" Value="Monster.DamageDice" ValueChanged="v => Set(() => Monster.DamageDice = v)" />
            <NumberField Label="Damage Die" Value="Monster.DamageDie" ValueChanged="v => Set(() => Monster.DamageDie = v)" />
            <NumberField Label="Damage Bonus" Value="Monster.DamageBonus" ValueChanged="v => Set(() => Monster.DamageBonus = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Ability Scores</legend>
        <div class="field-grid">
            <NumberField Label="Strength" Value="Monster.Strength" ValueChanged="v => Set(() => Monster.Strength = v)" />
            <NumberField Label="Dexterity" Value="Monster.Dexterity" ValueChanged="v => Set(() => Monster.Dexterity = v)" />
            <NumberField Label="Constitution" Value="Monster.Constitution" ValueChanged="v => Set(() => Monster.Constitution = v)" />
            <NumberField Label="Intelligence" Value="Monster.Intelligence" ValueChanged="v => Set(() => Monster.Intelligence = v)" />
            <NumberField Label="Wisdom" Value="Monster.Wisdom" ValueChanged="v => Set(() => Monster.Wisdom = v)" />
            <NumberField Label="Charisma" Value="Monster.Charisma" ValueChanged="v => Set(() => Monster.Charisma = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>HP</legend>
        <div class="field-grid">
            <NumberField Label="HP" Value="Monster.HitPoints" ValueChanged="v => Set(() => Monster.HitPoints = v)" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Biomes</legend>
        <EnumMultiSelect TEnum="Biome" Selected="Monster.Biomes" SelectedChanged="OnBiomesChanged"
                         Exclude="ExcludedBiomes" OnChanged="RaiseChanged" />
    </fieldset>

    <fieldset>
        <legend>D&amp;D Traits</legend>
        @if (Monster.Traits == null || Monster.Traits.Count == 0)
        {
            <div class="tag-empty">None</div>
        }
        else
        {
            @for (var i = 0; i < Monster.Traits.Count; i++)
            {
                var index = i;
                var trait = Monster.Traits[index];
                <div class="stacked-row">
                    <div class="field">
                        <label>Name</label>
                        <input value="@trait.Name" @onchange="e => Set(() => trait.Name = e.Value?.ToString())" />
                    </div>
                    <div class="field">
                        <label>Description</label>
                        <textarea value="@trait.Description" @onchange="e => Set(() => trait.Description = e.Value?.ToString())"></textarea>
                    </div>
                    <button class="danger" title="Remove" @onclick="() => RemoveTrait(index)">&times;</button>
                </div>
            }
        }
        <button @onclick="AddTrait">Add Trait</button>
    </fieldset>

    <fieldset>
        <legend>D&amp;D Actions</legend>
        @if (Monster.Actions == null || Monster.Actions.Count == 0)
        {
            <div class="tag-empty">None</div>
        }
        else
        {
            @for (var i = 0; i < Monster.Actions.Count; i++)
            {
                var index = i;
                var action = Monster.Actions[index];
                <div class="stacked-row">
                    <div class="field-grid">
                        <div class="field">
                            <label>Name</label>
                            <input value="@action.Name" @onchange="e => Set(() => action.Name = e.Value?.ToString())" />
                        </div>
                        <TextReferenceSelect Label="Item" Value="@action.ItemId" ValueChanged="v => Set(() => action.ItemId = v)"
                                             Options="DataSources.Items" IncludeNone="true" />
                        <NumberField Label="Count" Value="action.Count" ValueChanged="v => Set(() => action.Count = v)" />
                        <NumberField Label="Attack Bonus" Value="action.AttackBonus" ValueChanged="v => Set(() => action.AttackBonus = v)" />
                        <NumberField Label="Damage Dice" Value="action.DamageDice" ValueChanged="v => Set(() => action.DamageDice = v)" />
                        <NumberField Label="Damage Die" Value="action.DamageDie" ValueChanged="v => Set(() => action.DamageDie = v)" />
                        <NumberField Label="Damage Bonus" Value="action.DamageBonus" ValueChanged="v => Set(() => action.DamageBonus = v)" />
                        <div class="field">
                            <label>Damage Type</label>
                            <input value="@action.DamageType" @onchange="e => Set(() => action.DamageType = e.Value?.ToString())" />
                        </div>
                        <div class="field">
                            <label>Reach</label>
                            <input value="@action.Reach" @onchange="e => Set(() => action.Reach = e.Value?.ToString())" />
                        </div>
                        <div class="field">
                            <label>Range</label>
                            <input value="@action.Range" @onchange="e => Set(() => action.Range = e.Value?.ToString())" />
                        </div>
                    </div>
                    <div class="field">
                        <label>Description</label>
                        <textarea value="@action.Description" @onchange="e => Set(() => action.Description = e.Value?.ToString())"></textarea>
                    </div>
                    <button class="danger" title="Remove" @onclick="() => RemoveAction(index)">&times;</button>
                </div>
            }
        }
        <button @onclick="AddAction">Add Action</button>
    </fieldset>

    <fieldset>
        <legend>Items (drops)</legend>
        <StringListEditor Items="EnsureList(Monster.Items)" Options="DataSources.Items" OnChanged="RaiseChanged" />
    </fieldset>
}

@code {
    [Parameter] public Monster? Monster { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly Biome[] ExcludedBiomes = { Biome.None };

    private bool imageDropdownOpen;


    private string PreviewSource =>
        Monster == null
            ? string.Empty
            : ImageCatalog.GetImageDataUri(Monster.ImageId) ?? string.Empty;

    private string UnknownImageDisplayName => Monster == null ? string.Empty : $"#{Monster.ImageId} (unknown)";

    private string SelectedImageDisplayName =>
        Monster == null
            ? string.Empty
            : ImageCatalog.GetDisplayName(Monster.ImageId);

    private List<string> EnsureList(List<string>? list) => list ?? new List<string>();

    private async Task AddTrait()
    {
        if (Monster == null)
        {
            return;
        }

        Monster.Traits ??= new List<MonsterTrait>();
        Monster.Traits.Add(new MonsterTrait());
        await RaiseChanged();
    }

    private async Task RemoveTrait(int index)
    {
        if (Monster?.Traits == null || index < 0 || index >= Monster.Traits.Count)
        {
            return;
        }

        Monster.Traits.RemoveAt(index);
        await RaiseChanged();
    }

    private async Task AddAction()
    {
        if (Monster == null)
        {
            return;
        }

        Monster.Actions ??= new List<MonsterAction>();
        Monster.Actions.Add(new MonsterAction());
        await RaiseChanged();
    }

    private async Task RemoveAction(int index)
    {
        if (Monster?.Actions == null || index < 0 || index >= Monster.Actions.Count)
        {
            return;
        }

        Monster.Actions.RemoveAt(index);
        await RaiseChanged();
    }

    private async Task SetName(string? value)
    {
        if (Monster == null)
        {
            return;
        }

        Monster.Name = value ?? string.Empty;
        await RaiseChanged();
    }

    private void ToggleImageDropdown()
    {
        imageDropdownOpen = !imageDropdownOpen;
    }

    private async Task SelectImage(int id)
    {
        imageDropdownOpen = false;
        if (Monster != null)
        {
            Monster.ImageId = id;
            await RaiseChanged();
        }
    }

    private async Task OnRarityChanged(ChangeEventArgs e)
    {
        if (Monster != null && Enum.TryParse<Rarity>(e.Value?.ToString(), out var rarity))
        {
            Monster.Rarity = rarity;
            await RaiseChanged();
        }
    }

    private async Task OnBiomesChanged(List<Biome> biomes)
    {
        if (Monster != null)
        {
            Monster.Biomes = biomes;
        }

        await Task.CompletedTask;
    }

    private async Task Set(Action mutate)
    {
        mutate();
        await RaiseChanged();
    }

    private async Task RaiseChanged()
    {
        await OnChanged.InvokeAsync();
    }
}

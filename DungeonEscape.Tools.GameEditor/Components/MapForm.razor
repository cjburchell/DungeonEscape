@inject AssetContext Assets
@inject MapPreviewCatalog MapPreviewCatalog
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (Map == null)
{
    <div class="empty-state">Select a map from the list.</div>
}
else
{
    <div class="form-header">
        <div class="field" style="flex:2">
            <label>Map ID</label>
            <input value="@Map.Id" readonly />
        </div>
        <div class="field" style="flex:1">
            <label>Map Class</label>
            <label class="checkbox-row">
                <input type="checkbox"
                       checked="@IsOverworldMapClass"
                       @onchange="e => SetMapOverworld((bool)(e.Value ?? false))" />
                Overworld
            </label>
        </div>
    </div>

    <fieldset>
        <legend>Map Properties</legend>
        <div class="field-grid compact-grid">
            <div class="field">
                <label>Biome</label>
                <input value="@Biome" @onchange="e => SetBiome(e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Song</label>
                <div class="song-preview-row">
                    <select value="@Song" @onchange="e => SetSong(e.Value?.ToString())">
                        <option value="">(none)</option>
                        @if (!string.IsNullOrWhiteSpace(Song) && !AvailableSongs.Contains(Song, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@Song">@Song (missing/custom)</option>
                        }
                        @foreach (var song in AvailableSongs)
                        {
                            <option value="@song">@song</option>
                        }
                    </select>
                    <button type="button"
                            class="song-preview-button"
                            disabled="@(!CanPreviewSong)"
                            title="@SongPreviewTitle"
                            @onclick="ToggleSongPreview">
                        @SongPreviewButtonText
                    </button>
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Map Preview</legend>
        @if (Preview.Error != null)
        {
            <div class="empty-state compact">@Preview.Error</div>
        }
        else
        {
            <div class="map-preview-layout">
                <div class="map-preview-frame">
                    <img class="map-preview-image"
                         src="@Preview.MapImageUrl"
                         alt="Map preview for @Map.Id" />
                </div>
                <div class="map-preview-details">
                    <div class="map-preview-summary">
                        @Preview.Width x @Preview.Height tiles &middot;
                        @Preview.TileWidth x @Preview.TileHeight px &middot;
                        @Preview.UsedTiles.Count used tiles
                    </div>
                    <div class="map-used-tiles">
                        @foreach (var tile in Preview.UsedTiles)
                        {
                            <div class="map-used-tile" title="@GetTileTitle(tile)">
                                @if (tile.ImageUrl != null)
                                {
                                    <img src="@tile.ImageUrl" alt="@GetTileTitle(tile)" />
                                }
                                else
                                {
                                    <div class="map-used-tile-missing">?</div>
                                }
                                <span>@tile.TilesetName #@tile.LocalTileId</span>
                                <small>gid @tile.Gid &middot; @tile.UsageCount</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </fieldset>

    <fieldset>
        <legend>Objects (@FilteredObjects.Count)</legend>
        <div class="map-object-layout">
            <div class="map-object-list">
                <div class="search">
                    <input placeholder="Filter objects..." @bind="objectFilter" @bind:event="oninput" />
                </div>
                <div class="map-object-items">
                    @foreach (var mapObject in FilteredObjects)
                    {
                        var current = mapObject;
                        <div class="monster-item @(ReferenceEquals(current, selectedObject) ? "selected" : string.Empty)"
                             @onclick="() => SelectObject(current)">
                            <div class="meta">
                                <span class="name">@current.DisplayName</span>
                                <span class="sub">@current.Class &middot; @current.GroupName &middot; #@current.Id</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="map-object-form">
                <MapObjectForm Object="selectedObject" Maps="Maps" OnChanged="RaiseChanged" />
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Random Monsters</legend>
        <MapRandomMonsterListEditor Map="Map" OnChanged="RaiseChanged" />
    </fieldset>
}

@code {
    [Parameter] public MapDocument? Map { get; set; }
    [Parameter] public IReadOnlyList<MapDocument> Maps { get; set; } = Array.Empty<MapDocument>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private MapObjectDocument? selectedObject;
    private string objectFilter = string.Empty;
    private bool isPlayingSongPreview;
    private string? playingSong;
    private MapPreview Preview { get; set; } = new(null, 0, 0, 0, 0, Array.Empty<MapPreviewTile>(), null);

    private string Biome => GetMapProperty("biome");
    private string Song => GetMapProperty("song");
    private bool CanPreviewSong => GetSongPreviewUrl() != null;
    private string SongPreviewButtonText => isPlayingSongPreview && string.Equals(playingSong, Song, StringComparison.OrdinalIgnoreCase)
        ? "Stop"
        : "Play";
    private string SongPreviewTitle => CanPreviewSong
        ? $"Preview {Song}.ogg"
        : "Select an existing music file to preview.";
    private bool IsOverworldMapClass => string.Equals(Map?.Class, OverworldMapClass, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<string> AvailableSongs
    {
        get
        {
            var musicDirectory = Assets.MusicDirectory;
            if (string.IsNullOrWhiteSpace(musicDirectory) || !Directory.Exists(musicDirectory))
            {
                return Array.Empty<string>();
            }

            return Directory
                .EnumerateFiles(musicDirectory, "*.ogg", SearchOption.TopDirectoryOnly)
                .Select(Path.GetFileNameWithoutExtension)
                .Where(song => !string.IsNullOrWhiteSpace(song))
                .Select(song => song!)
                .OrderBy(song => song, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private const string OverworldMapClass = "Overworld";

    private List<MapObjectDocument> FilteredObjects => Map == null
        ? new List<MapObjectDocument>()
        : Map.Objects
            .Where(ObjectMatchesFilter)
            .OrderBy(ObjectSortKey)
            .ThenBy(item => item.Id)
            .ToList();

    protected override void OnParametersSet()
    {
        if (Map == null)
        {
            selectedObject = null;
            Preview = MapPreviewCatalog.GetPreview(null);
            return;
        }

        Preview = MapPreviewCatalog.GetPreview(Map);
        if (selectedObject == null || !Map.Objects.Contains(selectedObject))
        {
            selectedObject = Map.Objects.FirstOrDefault();
        }
    }

    private static string GetTileTitle(MapPreviewTile tile) =>
        $"{tile.TilesetName} tile {tile.LocalTileId} (gid {tile.Gid}), used {tile.UsageCount} time(s)";

    private bool ObjectMatchesFilter(MapObjectDocument mapObject)
    {
        if (string.IsNullOrWhiteSpace(objectFilter))
        {
            return true;
        }

        return mapObject.DisplayName.Contains(objectFilter, StringComparison.OrdinalIgnoreCase) ||
               mapObject.Class.Contains(objectFilter, StringComparison.OrdinalIgnoreCase) ||
               mapObject.GroupName.Contains(objectFilter, StringComparison.OrdinalIgnoreCase) ||
               mapObject.Id.ToString().Contains(objectFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static int ObjectSortKey(MapObjectDocument mapObject)
    {
        if (mapObject.Class.StartsWith("Npc", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (string.Equals(mapObject.Class, "Chest", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(mapObject.Class, "HiddenItem", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(mapObject.Class, "Door", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        return 2;
    }

    private void SelectObject(MapObjectDocument mapObject)
    {
        selectedObject = mapObject;
    }

    private async Task SetMapOverworld(bool value)
    {
        if (Map == null)
        {
            return;
        }

        Map.Class = value ? OverworldMapClass : string.Empty;
        await RaiseChanged();
    }

    private string GetMapProperty(string name) =>
        Map != null && Map.Properties.TryGetValue(name, out var value) ? value : string.Empty;

    private async Task SetBiome(string? value) => await SetMapProperty("biome", value);

    private async Task SetSong(string? value)
    {
        await StopSongPreview();
        await SetMapProperty("song", value);
    }

    private async Task ToggleSongPreview()
    {
        if (isPlayingSongPreview && string.Equals(playingSong, Song, StringComparison.OrdinalIgnoreCase))
        {
            await StopSongPreview();
            return;
        }

        var previewUrl = GetSongPreviewUrl();
        if (previewUrl == null)
        {
            await StopSongPreview();
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("dungeonEscapeAudioPreview.play", previewUrl);
            playingSong = Song;
            isPlayingSongPreview = true;
        }
        catch
        {
            playingSong = null;
            isPlayingSongPreview = false;
        }
    }

    private string? GetSongPreviewUrl() =>
        MusicPreviewCache.GetPreviewUrl(Assets.MusicDirectory, Song);

    private async Task StopSongPreview()
    {
        try
        {
            await Js.InvokeVoidAsync("dungeonEscapeAudioPreview.stop");
        }
        catch
        {
            // Ignore JS cleanup failures during shutdown/navigation.
        }

        playingSong = null;
        isPlayingSongPreview = false;
    }

    private async Task SetMapProperty(string name, string? value)
    {
        if (Map == null)
        {
            return;
        }

        value ??= string.Empty;
        if (string.IsNullOrEmpty(value))
        {
            Map.Properties.Remove(name);
        }
        else
        {
            Map.Properties[name] = value;
        }

        await RaiseChanged();
    }

    private async Task RaiseChanged() => await OnChanged.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        await StopSongPreview();
    }
}
